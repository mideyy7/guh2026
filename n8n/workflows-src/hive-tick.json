      "parameters": {
        "jsCode": "//@@HIVE_CORE@@\nconst b = $input.first().json;\nconst out = HiveCore.act(b.state, { hq: b.hq }, Date.now());\nreturn [{ json: { version: b.version, state: out.state, actions: out.actions } }];\n"
      },
